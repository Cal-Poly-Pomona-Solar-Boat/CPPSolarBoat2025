int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_I2C3_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  MX_FDCAN1_Init();
  MX_I2C4_Init();
  MX_I2C2_Init();
  MX_TIM8_Init();
  MX_DAC1_Init();
  MX_TIM15_Init();
  /* USER CODE BEGIN 2 */

    HAL_TIM_Base_Start(&htim2);
    Stepper_Init(&htim8, &htim15);

    /* DAC clock + PA4 (CH1) and PA5 (CH2) analog mode */
    __HAL_RCC_DAC1_CLK_ENABLE();
    {
        GPIO_InitTypeDef gpio = {0};
        gpio.Pin  = GPIO_PIN_4 | GPIO_PIN_5;
        gpio.Mode = GPIO_MODE_ANALOG;
        gpio.Pull = GPIO_NOPULL;
        HAL_GPIO_Init(GPIOA, &gpio);
    }

    /* Start BOTH DAC channels (PA4 = motor 1, PA5 = motor 2) */
    HAL_DAC_Start(&hdac1, DAC_CHANNEL_1);
    HAL_DAC_Start(&hdac1, DAC_CHANNEL_2);
    HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, DAC_OUT_MIN);
    HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_2, DAC_ALIGN_12B_R, DAC_OUT_MIN);

    /* CAN filter + start */
    sFilterConfig.IdType       = FDCAN_STANDARD_ID;
    sFilterConfig.FilterIndex  = 0;
    sFilterConfig.FilterType   = FDCAN_FILTER_DUAL;
    sFilterConfig.FilterConfig = FDCAN_FILTER_TO_RXFIFO0;
    sFilterConfig.FilterID1    = 0x000;
    sFilterConfig.FilterID2    = 0x000;
    if (HAL_FDCAN_ConfigFilter(&hfdcan1, &sFilterConfig) != HAL_OK) Error_Handler();
    if (HAL_FDCAN_ConfigGlobalFilter(&hfdcan1,
            FDCAN_REJECT, FDCAN_REJECT,
            FDCAN_FILTER_REMOTE, FDCAN_FILTER_REMOTE) != HAL_OK) Error_Handler();
    if (HAL_FDCAN_Start(&hfdcan1) != HAL_OK) Error_Handler();

    BspCOMInit.BaudRate   = 115200;
    BspCOMInit.WordLength = COM_WORDLENGTH_8B;
    BspCOMInit.StopBits   = COM_STOPBITS_1;
    BspCOMInit.Parity     = COM_PARITY_NONE;
    BspCOMInit.HwFlowCtl  = COM_HWCONTROL_NONE;
    if (BSP_COM_Init(COM1, &BspCOMInit) != BSP_ERROR_NONE) Error_Handler();

    printf("\r\n=== THROTTLE BYPASS BUILD (DUAL DAC) ===\r\n");
    printf("ADC=PC1 (CH7)  DAC=PA4 (CH1) + PA5 (CH2)\r\n");
    printf("Map: ADC[%u..%u] -> DAC[%u..%u]\r\n",
           (unsigned)THROTTLE_ADC_MIN, (unsigned)THROTTLE_ADC_MAX,
           (unsigned)DAC_OUT_MIN,      (unsigned)DAC_OUT_MAX);
    printf("DAC floor: %u  (~%.2fV at PA4/PA5)\r\n",
           (unsigned)DAC_OUT_MIN, (DAC_OUT_MIN * 3.3f) / 4096.0f);
    printf("=========================================\r\n\r\n");

  /* USER CODE END 2 */

  BspCOMInit.BaudRate   = 115200;
  BspCOMInit.WordLength = COM_WORDLENGTH_8B;
  BspCOMInit.StopBits   = COM_STOPBITS_1;
  BspCOMInit.Parity     = COM_PARITY_NONE;
  BspCOMInit.HwFlowCtl  = COM_HWCONTROL_NONE;
  if (BSP_COM_Init(COM1, &BspCOMInit) != BSP_ERROR_NONE)
  {
    Error_Handler();
  }

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      uint32_t now = HAL_GetTick();

      uint8_t did_zero_steering = (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_10) == GPIO_PIN_SET) ? 1U : 0U;

      /* -----------------------------------------------------------------
       * ID 0x040 — steering  (AS5600 #1, I2C3)  [ACTIVE]
       * ----------------------------------------------------------------- */
      if (now - last_tick_steering >= RATE_STEERING_MS)
      {
          if (HAL_I2C_Mem_Read(&hi2c3, 0x36 << 1, 0x0E,
                  I2C_MEMADD_SIZE_8BIT, steering_data, 2, SENSOR_PENDING_MS) == HAL_OK)
          {
              steering_raw = ((uint16_t)steering_data[0] << 8) | steering_data[1];
              steering_deg = (steering_raw * 360.0f) / 4096.0f;

              if (did_zero_steering)
              {
                  Stepper_SetZero(steering_deg);
                  Stepper_Enable();
              }

              Stepper_Update(steering_deg);
              can_tx_steering1(steering_deg);
          }
          else
          {
              i2c_error = HAL_I2C_GetError(&hi2c3);
              i2c_retry(&hi2c3);
          }

          last_tick_steering = now;
      }

      /* -----------------------------------------------------------------
       * ID 0x2C8 — throttle  (PC1 ADC -> PA4 + PA5 DAC + CAN)  [ACTIVE]
       * ----------------------------------------------------------------- */
      if (now - last_tick_throttle >= RATE_THROTTLE_MS)
      {
          throttle_raw = read_adc();
          throttle_out = (throttle_raw * 3.3f) / 4096.0f;

          throttle_dac = throttle_to_dac(throttle_raw);
          HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, throttle_dac); /* PA4 = motor 1 */
          HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_2, DAC_ALIGN_12B_R, throttle_dac); /* PA5 = motor 2 */

          can_tx_throttle(throttle_out);
          last_tick_throttle = now;
      }

      /* -----------------------------------------------------------------
       * Verbose throttle debug — print 4x per second
       * ----------------------------------------------------------------- */
      if (now - last_tick_debug >= RATE_DEBUG_PRINT_MS)
      {
          float pa_volts = (throttle_dac * 3.3f) / 4096.0f;
          printf("ADC=%4u (%.2fV @ PC1) -> DAC=%4u (%.2fV @ PA4/PA5) | DOR1=%lu DOR2=%lu\r\n",
                 (unsigned)throttle_raw,
                 throttle_out,
                 (unsigned)throttle_dac,
                 pa_volts,
                 (unsigned long)DAC1->DOR1,
                 (unsigned long)DAC1->DOR2);
          last_tick_debug = now;
      }

      /* Bypassed: AS5600 #2/#3, ADXL #1/#2, Hall RPM */

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

