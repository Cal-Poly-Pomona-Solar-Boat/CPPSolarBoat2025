static void i2c_retry(I2C_HandleTypeDef *hi2c)
{
    HAL_I2C_DeInit(hi2c);
    HAL_I2C_Init(hi2c);
    HAL_I2CEx_ConfigAnalogFilter(hi2c, I2C_ANALOGFILTER_ENABLE);
    HAL_I2CEx_ConfigDigitalFilter(hi2c, 0);
}

static uint16_t read_adc(void)
{
    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, 10);
    uint16_t v = (uint16_t)HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    return v;
}

/* Throttle ADC -> DAC: clamp to [MIN..MAX] window, linearly map to [DAC_OUT_MIN..DAC_OUT_MAX] */
static uint16_t throttle_to_dac(uint16_t adc)
{
    if (adc <= THROTTLE_ADC_MIN) return DAC_OUT_MIN;
    if (adc >= THROTTLE_ADC_MAX) return DAC_OUT_MAX;

    uint32_t span_in  = (uint32_t)(THROTTLE_ADC_MAX - THROTTLE_ADC_MIN);
    uint32_t span_out = (uint32_t)(DAC_OUT_MAX     - DAC_OUT_MIN);
    uint32_t scaled   = (((uint32_t)(adc - THROTTLE_ADC_MIN)) * span_out) / span_in;
    return (uint16_t)(scaled + DAC_OUT_MIN);
}

/* EXTI ISR — kept only for stepper encoder (Hall RPM bypassed in this build) */
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == GPIO_PIN_0 || GPIO_Pin == GPIO_PIN_1)
    {
        return; /* RPM Hall sensors bypassed */
    }
    else if (GPIO_Pin == GPIO_PIN_10 ||
             GPIO_Pin == GPIO_PIN_11 ||
             GPIO_Pin == GPIO_PIN_12 ||
             GPIO_Pin == GPIO_PIN_2)
    {
        Stepper_EncoderISR(GPIO_Pin);
    }
}

