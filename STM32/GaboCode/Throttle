/* --- Throttle DAC mapping ---
 *
 *   THROTTLE_ADC_MIN/MAX : usable input window from the pot
 *                          Tune to your actual idle/WOT ADC readings (printed each loop).
 *   DAC_OUT_MIN          : DAC code at idle. 620 -> ~0.5V at PA4/PA5.
 *                          After op-amp gain (~1.5) this is ~0.75V on the 5V output.
 *   DAC_OUT_MAX          : DAC code at WOT. 4095 -> 3.3V at PA4/PA5 -> ~5V after op-amp.
 *
 * ADJUST THESE based on the printed ADC values:
 *   - Run idle, note the printed ADC -> set THROTTLE_ADC_MIN slightly above
 *   - Run WOT,  note the printed ADC -> set THROTTLE_ADC_MAX slightly below
 */
#define THROTTLE_ADC_MIN   100U     /* TUNE: idle pot reading + small margin */
#define THROTTLE_ADC_MAX   3995U    /* TUNE: WOT  pot reading - small margin */
#define DAC_OUT_MIN         620U    /* ~0.5V at PA4/PA5 (0.5/3.3 * 4096 = 621) */
#define DAC_OUT_MAX        4095U    /* full scale -> 3.3V at PA4/PA5 */

uint16_t throttle_dac = 0;

/* --- FDCAN filter --- */
FDCAN_FilterTypeDef sFilterConfig;

/* --- Send-rate intervals (ms) --- */
#define SENSOR_PENDING_MS    10U
#define RATE_STEERING_MS      2U
#define RATE_THROTTLE_MS     20U
#define RATE_DEBUG_PRINT_MS 250U

